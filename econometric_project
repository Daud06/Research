#data

dataset <- data[, c("Companie_name", 'Profit', 'Category','BT_after_year', 'Equity', "code", 'Year',"staff", "ROE", "Assets", "BT", "Income")]
summary(dataset)

#Запоняем пропуски в стафф и ROE

data_clean <- dataset %>%
  group_by(code) %>%
  filter(!any(is.na(ROE) | is.na(staff) | is.na(Profit) | is.na(Income) | is.na(Equity) )) %>%
  ungroup()

data_clean[apply(data_clean, 1, function(x) any(is.na(x))),]

data_clean$log_assets = log(data_clean$Assets)
data_clean$log_income = log(data_clean$Income)
#data$log_profit = data$Profit
data_clean$log_staff = log(data_clean$staff)
data_clean$ROE = data_clean$ROE / 100
data_clean$leverage = (data_clean$Assets - data_clean$Equity) / data_clean$Assets

q1 = quantile(data_clean$ROE, 0.01, na.rm = TRUE)
q99 = quantile(data_clean$ROE, 0.99, na.rm = TRUE)

data_clean <- data_clean %>%
  group_by(code) %>%
  filter(!any(ROE < q1 | ROE > q99)) %>%
  ungroup()

count(distinct(data_clean['code']))
hist(data_clean$ROE)

#summary(data_clean$ROA)
#cor(data_clean)

data_clean$A_turnover = data_clean$Income / data_clean$Assets
data_clean$ROA = data_clean$Profit / data_clean$Assets
data_clean$log_aturnover <- log(data_clean$A_turnover)
