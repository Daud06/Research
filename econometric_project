vif(model)

bptest(model)
coeftest(model, vcov = vcovHC(model, type = "HC1"))

#тест Хаусмана

pdata <- pdata.frame(data_clean, index = c("code", "Year"))
pdata

model_fe <- plm(A_turnover ~ log_assets + log_income + log_staff  + leverage + BT, data = pdata, model = "within")
model_re <- plm(A_turnover ~ log_assets + log_income + log_staff  + leverage + BT, data = pdata, model = "random")

phtest(model_fe, model_re)

#Ftest на наличие фикс эффектов
model_pool <- plm(ROE ~ log_assets + BT + log_staff + log_income + leverage + factor(Year), data = pdata, model = "pooling")
model_fe <- plm(ROE ~ log_assets + BT + log_staff   + log_income + leverage + factor(Year), data = pdata, model = "within")

pFtest(model_fe, model_pool)

#Рассчитаем модели
model_roa_pool <- plm(ROA ~ log_assets + BT + log_staff + log_income + leverage + factor(Year), data = pdata, model = "pooling")
